JARVIS_PORT=7330
JARVIS_MCP_PORT=7331
# Optional: uncomment after `docker compose up -d` for PostgreSQL + pgvector.
# DATABASE_URL=postgresql://jarvis:jarvis@127.0.0.1:5432/jarvis
# Optional: default storage location is ~/.jarvis
# JARVIS_HOME=~/.jarvis
# MEMORY_ROOT=~/.jarvis/memory
# SKILLS_ROOT=~/.jarvis/skills
# Optional bootstrap name. Leave unset to ask the user on first start.
# JARVIS_ASSISTANT_NAME=Jarvis
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_COGNITIVE_PROVIDER=ollama
# Required only when the HTTP API is reachable beyond loopback.
# JARVIS_API_TOKEN=replace-with-a-long-random-token
